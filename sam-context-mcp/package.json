{
  "name": "sam-context-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing structured personal context for AI agent retrieval",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.ts",
    "validate": "tsx scripts/validate-context.ts",
    "build:index": "tsx scripts/build-index.ts",
    "export:bundle": "tsx scripts/export-bundle.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
